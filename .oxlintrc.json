{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off"
  },
  "rules": {
    // Obsolete under the automatic JSX runtime ("jsx": "react-jsx"), which
    // compiles to jsx() from react/jsx-runtime rather than to
    // React.createElement -- so React does not need to be in scope, and
    // importing it only to satisfy this rule would add a real import for no
    // reason.
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "es2022": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist", "coverage", "node_modules"]
}
